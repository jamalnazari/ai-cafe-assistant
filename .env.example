# Backend (development defaults use mock AI providers)
DATABASE_URL=sqlite+aiosqlite:///./cafe.db
SECRET_KEY=replace-with-a-long-random-secret
STT_PROVIDER=mock
LLM_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=mock-key
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini

# Owner session cookie. Keep False only for local HTTP development.
SESSION_COOKIE_NAME=cafe_owner_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=False

# Server-side Next.js requests and rewrites to FastAPI
API_INTERNAL_URL=http://127.0.0.1:8000
