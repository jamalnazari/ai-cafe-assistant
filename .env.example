# --- محیط اجرا ---
# development برای توسعهٔ محلی، production روی سرور
ENVIRONMENT=development

# --- بک‌اند ---
# مسیر دیتابیس نسبت به پوشهٔ apps/api است
DATABASE_URL=sqlite+aiosqlite:///./cafe.db

# در production الزامی است: رشتهٔ تصادفی با حداقل ۳۲ نویسه
# ساخت نمونه: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# --- نشست مالک ---
SESSION_COOKIE_NAME=cafe_owner_session
SESSION_TTL_SECONDS=604800
# اگر خالی بماند، در production خودکار True و در توسعه False می‌شود
SESSION_COOKIE_SECURE=

# --- محدودیت نرخ (محافظت از هزینهٔ API و رمز مالک) ---
RATE_LIMIT_ENABLED=True
ASK_RATE_LIMIT=20
ASK_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=300
# اگر پشت Caddy/Nginx هستید True شود تا IP واقعی مشتری خوانده شود
TRUST_PROXY_HEADERS=False
# دامنهٔ مجاز؛ خالی یعنی بدون محدودیت. نمونه: cafe.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=

# --- پشتیبان‌گیری ---
BACKUP_KEEP=14
# BACKUP_DIR=/var/backups/ai-cafe-assistant

# --- پشتیبان‌گیری از تصاویر منو و هویت کافه ---
# در production بهتر است خارج از پوشهٔ پروژه باشد تا redeploy آن را پاک نکند
# UPLOAD_DIR=/var/lib/ai-cafe-assistant/uploads/menu_items
# BRANDING_UPLOAD_DIR=/var/lib/ai-cafe-assistant/uploads/branding

# سقف حجم فایل صوتی پرسش مشتری (بایت)؛ ۲۵ مگابایت پیش‌فرض
# MAX_AUDIO_UPLOAD_BYTES=26214400

# --- حساب مدیر سامانه (پنل مدیریت کافه‌ها) ---
# در اولین اجرا با همین نام کاربری/رمز ساخته می‌شود؛ در production تغییر دهید.
ADMIN_USERNAME=jamal
ADMIN_PASSWORD=Jamal@1381

# --- سرویس هوش مصنوعی ---
# mock = پاسخ نمونه بدون هزینه؛ openai = هر سرویس سازگار با OpenAI
LLM_PROVIDER=mock
STT_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=mock-key
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2

# نمونهٔ آماده برای Dahl (https://dahl.global) — سازگار با OpenAI:
# LLM_PROVIDER=dahl
# AI_BASE_URL=https://inference.dahl.global/v1
# AI_API_KEY=کلید-خودتان
# LLM_MODEL=zai-org/GLM-5.3-Flash      # یا MiniMax M2.7 یا DeepSeek V4
# پس از تنظیم، اتصال را با «npm run check:llm» آزمایش کنید.

# نمونهٔ OpenAI:
# LLM_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- فرانت‌اند (Next.js) ---
# این متغیر را در apps/web/.env.local بگذارید، نه اینجا
# API_INTERNAL_URL=http://127.0.0.1:8000
